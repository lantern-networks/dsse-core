diff --git a/postgres-appliance/build_scripts/prepare.sh b/postgres-appliance/build_scripts/prepare.sh
index 8590e34..943a635 100644
--- a/postgres-appliance/build_scripts/prepare.sh
+++ b/postgres-appliance/build_scripts/prepare.sh
@@ -6,0 +7,7 @@ echo -e 'APT::Install-Recommends "0";\nAPT::Install-Suggests "0";' > /etc/apt/ap
+# DSSE: the database user owns every existing data directory by NUMBER. Created first, with the ids the
+# published images have always used, so a package that creates system users of its own (systemd's, or
+# postgresql-common 295's sysusers entry) cannot take 101/103 and move postgres to another uid.
+groupadd --system --gid 103 postgres
+useradd --system --uid 101 --gid 103 --home-dir /var/lib/postgresql --no-create-home --shell /bin/bash \
+    --comment "PostgreSQL administrator" postgres
+
