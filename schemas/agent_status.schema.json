      "type": "object",
      "description": "Operational Agent telemetry. Phase 1 uses crash_count and steering_* counters as the endpoint-side Agent Quality signal.",
      "properties": {
        "client": {
          "type": "string"
        },
        "crash_count": {
          "type": "integer",
          "minimum": 0
        },
        "steering_attempted": {
          "type": "integer",
          "minimum": 0
        },
        "steering_succeeded": {
          "type": "integer",
          "minimum": 0
        },
        "steering_failed": {
          "type": "integer",
          "minimum": 0
        },
        "connect_unsupported": {
          "type": "integer",
          "minimum": 0
        },
        "network_extension_rules_ref": {
          "type": "string"
        },
        "network_extension_rules_status": {
          "type": "string",
          "enum": [
            "loaded",
            "unavailable"
          ]
        },
        "network_extension_rule_count": {
          "type": "integer",
          "minimum": 0
        },
        "transparent_steering_runtime": {
          "type": "string",
          "enum": [
            "not_installed",
            "app_proxy_provider",
            "packet_tunnel_provider"
          ]
        },
        "network_extension_runtime_evidence_ref": {
          "type": "string"
        },
        "network_extension_runtime_evidence_status": {
          "type": "string",
          "enum": [
            "loaded",
            "unavailable",
            "invalid"
          ]
        },
        "network_extension_runtime_invalid_reason": {
          "type": "string",
          "enum": [
            "counter_inconsistent",
            "evidence_source_invalid",
            "flow_extraction_gate",
            "installed_overclaim",
            "not_installed_overclaim",
            "parse_error",
            "runtime_provider_invalid",
            "rules_loaded_overclaim",
            "rules_not_loaded_overclaim",
            "schema_mismatch",
            "secret_leak_gate",
            "stopped_runtime_overclaim",
            "unavailable"
          ]
        },
        "network_extension_runtime_installed": {
          "type": "boolean"
        },
        "network_extension_runtime_running": {
          "type": "boolean"
        },
        "network_extension_runtime_provider": {
          "type": "string",
          "enum": [
            "not_installed",
            "app_proxy_provider",
            "packet_tunnel_provider"
          ]
        },
        "network_extension_runtime_rules_loaded": {
          "type": "boolean"
        },
        "network_extension_runtime_rule_count": {
          "type": "integer",
          "minimum": 0
        },
        "network_extension_runtime_flow_extraction_attempted": {
          "type": "integer",
          "minimum": 0
        },
        "network_extension_runtime_flow_extraction_succeeded": {
          "type": "integer",
          "minimum": 0
        },
        "network_extension_runtime_flow_extraction_denied": {
          "type": "integer",
          "minimum": 0
        },
        "network_extension_runtime_flow_extraction_gate": {
          "type": "string",
          "enum": [
            "ok"
          ]
        },
        "network_extension_runtime_flow_attempted": {
          "type": "integer",
          "minimum": 0
        },
        "network_extension_runtime_flow_tunneled": {
          "type": "integer",
          "minimum": 0
        },
        "network_extension_runtime_flow_denied": {
          "type": "integer",
          "minimum": 0
        },
        "network_extension_runtime_evidence_source": {
          "type": "string",
          "description": "Forwarded runtime evidence source. agent_status is not accepted as proof of an installed Network Extension runtime; it is reserved for a future Agent Status mirror writer.",
