{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/codex_coordination_result.schema.json",
  "title": "CodexCoordinationResult",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "task_id",
    "role",
    "status",
    "created_at",
    "summary",
    "artifacts",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "codex_coordination_result.v1"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "task_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "dev",
        "human_validation",
        "claude_review"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "blocked",
        "info"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "description"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
