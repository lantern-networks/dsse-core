<?xml version="1.0" encoding="utf-8"?>
<!--
  DsseBundle.wxs — Burn bootstrapper that wraps the DsseAgent MSI into a single signed DsseAgentSetup.exe
  (a Burn bootstrapper). It installs the MSI. Authentication opens the user's default browser.

  The FINE compatibility gate (arch / S Mode / HVCI / Secure Boot / Win11 build) is the MSI's job (compatcheck /
  M8.2); the bundle only enforces the coarse "64-bit Windows" precondition and gives the install a UI + a single
  signed artifact for distribution. The packaged agent is pure Go + a kernel driver, so it needs NO VC++ redist.

  Build:
    wix build DsseBundle.wxs -ext WixToolset.BootstrapperApplications.wixext/7.0.0 -ext WixToolset.Util.wixext/7.0.0
              -b <dir-with-DsseAgent.msi> -d Version=x.y.z -o DsseAgentSetup.exe
-->
<!-- Guarded: an unguarded <?define?> WINS over the build's -d, so it is an override wearing a default's
     clothes. DsseAgent.wxs shipped exactly that and produced ProductVersion 0.1.0 for every -Version asked for;
     ops/checks/windows_packaging_buildability.sh now refuses both files without the guard. -->
<?ifndef Version ?>
  <?define Version = "0.1.0" ?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="Lantern DSSE Agent"
          Manufacturer="Lantern Networks"
          Version="$(var.Version)"
          UpgradeCode="8B1E5F2C-3D47-4A9E-B6C1-7E90D2F4A118">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense" LicenseUrl="" SuppressOptionsUI="yes" />
    </BootstrapperApplication>

    <!-- Coarse precondition only: 64-bit Windows (kernel driver = no emulation, no 32-bit). The detailed gate
         (S Mode / HVCI / Secure Boot vs signing / Win11 build / ARM64 artifact selection) is compatcheck inside
         the MSI. -->
    <bal:Condition Condition="VersionNT64" Message="Lantern DSSE Agent requires 64-bit Windows." />

    <Chain>
      <MsiPackage SourceFile="DsseAgent.msi" Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
