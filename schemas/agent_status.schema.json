        "windows_observe_capture_mode": {
          "type": "string",
          "enum": [
            "sniff"
          ]
        },
        "windows_observe_observed_services": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "smb",
              "winrm_http",
              "winrm_https",
              "rdp"
            ]
          }
        },
        "windows_observe_observed_flow_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "windows_observe_destination_ip_mode": {
          "type": "string",
          "enum": [
            "cidr_bucket"
          ]
