{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/windows_observe_mode_report.schema.json",
  "title": "WindowsObserveModeReport",
  "description": "Windows Observe Mode report. v1 is not-installed only. v2 is an installed WinDivert observe-only contract that remains gated until runtime provenance is available.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "created_at",
        "platform",
        "mode",
        "network_filter",
        "driver",
        "driver_installed",
        "driver_running",
        "enforcement_enabled",
        "steering_attempted",
        "steering_succeeded",
        "steering_failed",
        "observed_protocols",
        "runtime_overclaim_gate",
        "secret_leak_gate",
        "next_runtime_candidate"
      ],
      "properties": {
        "schema_version": { "const": "windows_observe_mode_report.v1" },
        "status": { "const": "ok" },
        "created_at": { "type": "string", "format": "date-time" },
        "platform": { "const": "windows" },
        "mode": { "const": "observe" },
        "network_filter": { "const": "not_installed" },
        "driver": { "const": "none" },
        "driver_installed": { "const": false },
        "driver_running": { "const": false },
        "enforcement_enabled": { "const": false },
        "steering_attempted": { "const": 0 },
        "steering_succeeded": { "const": 0 },
        "steering_failed": { "const": 0 },
        "observed_protocols": {
          "type": "array",
          "maxItems": 0
        },
        "runtime_overclaim_gate": { "const": "ok" },
        "secret_leak_gate": { "const": "ok" },
        "next_runtime_candidate": {
          "type": "string",
          "enum": ["windivert_userspace", "wfp_callout_driver"]
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "created_at",
        "platform",
        "mode",
        "network_filter",
        "driver",
        "driver_installed",
        "driver_running",
        "runtime_evidence_source",
        "collector_status",
        "driver_name",
        "driver_version",
        "driver_sha256",
        "capture_filter",
        "capture_mode",
        "packet_write_enabled",
        "reinject_required",
        "drop_capability",
        "packet_reinject_attempted",
        "enforcement_enabled",
        "observed_services",
        "port_profiles",
        "observed_flow_count",
        "max_observed_flow_count",
        "event_count_max",
        "report_file_max_bytes",
        "report_byte_size",
        "ring_buffer_policy",
        "dropped_packet_count",
        "destination_ip_mode",
        "payload_capture_gate",
        "classification_method",
        "protocol_confidence",
        "protocol_verified",
        "handshake_inspected",
        "payload_parser",
        "attribution_source",
        "process_unknown",
        "identity_stamp_source",
        "collector_identity_trusted",
        "identity_mismatch_gate",
        "runtime_overclaim_gate",
        "secret_leak_gate"
      ],
      "properties": {
        "schema_version": { "const": "windows_observe_mode_report.v2" },
        "status": { "const": "ok" },
        "created_at": { "type": "string", "format": "date-time" },
        "platform": { "const": "windows" },
        "mode": { "const": "observe" },
        "network_filter": { "const": "windivert_userspace" },
        "driver": { "const": "windivert" },
        "driver_installed": { "const": true },
        "driver_running": { "const": true },
        "runtime_evidence_source": { "const": "collector_runtime" },
        "collector_status": { "const": "running" },
        "driver_name": { "const": "WinDivert" },
        "driver_version": { "type": "string", "minLength": 1 },
        "driver_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capture_filter": { "type": "string", "minLength": 1 },
        "capture_mode": { "const": "sniff" },
        "packet_write_enabled": { "const": false },
        "reinject_required": { "const": false },
        "drop_capability": { "const": false },
        "packet_reinject_attempted": { "const": 0 },
        "enforcement_enabled": { "const": false },
        "observed_services": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["smb", "winrm_http", "winrm_https", "rdp"]
          }
        },
        "port_profiles": { "type": "array" },
        "observed_flow_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "max_observed_flow_count": { "const": 10000 },
        "event_count_max": { "const": 10000 },
        "report_file_max_bytes": { "const": 1048576 },
        "report_byte_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "ring_buffer_policy": { "const": "oldest_drop" },
        "dropped_packet_count": { "const": 0 },
        "destination_ip_mode": { "const": "cidr_bucket" },
        "payload_capture_gate": { "const": "disabled" },
        "classification_method": { "const": "destination_port" },
        "protocol_confidence": { "const": "port_inferred" },
        "protocol_verified": { "const": false },
        "handshake_inspected": { "const": false },
        "payload_parser": { "const": "none" },
        "attribution_source": { "const": "none" },
        "process_unknown": { "const": true },
        "identity_stamp_source": {
          "type": "string",
          "enum": ["agent_config", "runtime_auth_context"]
        },
        "collector_identity_trusted": { "const": false },
        "identity_mismatch_gate": { "const": "ok" },
        "runtime_overclaim_gate": { "const": "ok" },
        "secret_leak_gate": { "const": "ok" },
        "runtime_evidence_kind": {
          "type": "string",
          "enum": ["fixture", "human_windows_capture"]
        },
        "flow_event_schema_version": { "const": "windows_observe_flow_event.v1" },
        "smb445_observe_minimum_required": { "const": true },
        "smb445_observe_event_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "smb445_observe_minimum_gate": { "const": "ok" },
        "payload_event_redaction_gate": { "const": "ok" },
        "flow_events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "required": [
              "schema_version",
              "event_id",
              "created_at",
              "identity_provenance",
              "tenant_id_source",
              "device_id_source",
              "agent_id_source",
              "direction",
              "protocol",
              "destination_ip_mode",
              "destination_ip",
              "destination_port",
              "observed_service",
              "port_profile",
              "classification_method",
              "protocol_confidence",
              "protocol_verified",
              "handshake_inspected",
              "action",
              "enforcement_enabled",
              "payload_captured",
              "payload_parser",
              "attribution_source",
              "process_unknown",
              "collector_instance_id",
              "collector_identity_trusted",
              "runtime_source"
            ],
            "properties": {
              "schema_version": { "const": "windows_observe_flow_event.v1" },
              "event_id": { "type": "string", "minLength": 8, "maxLength": 96 },
              "created_at": { "type": "string", "format": "date-time" },
              "identity_provenance": { "const": "local_client_agent_cache" },
              "tenant_id_source": { "const": "local_client" },
              "device_id_source": { "const": "local_client" },
              "agent_id_source": { "const": "local_client" },
              "direction": { "const": "outbound" },
              "protocol": { "const": "tcp" },
              "destination_ip_mode": { "const": "cidr_bucket" },
              "destination_ip": { "type": "string", "minLength": 1 },
              "destination_port": { "const": 445 },
              "observed_service": { "const": "smb" },
              "port_profile": { "const": "smb_445" },
              "classification_method": { "const": "destination_port" },
              "protocol_confidence": { "const": "port_inferred" },
              "protocol_verified": { "const": false },
              "handshake_inspected": { "const": false },
              "action": { "const": "observed" },
              "enforcement_enabled": { "const": false },
              "payload_captured": { "const": false },
              "payload_parser": { "const": "none" },
              "attribution_source": { "const": "none" },
              "process_unknown": { "const": true },
              "collector_instance_id": { "type": "string", "minLength": 1, "maxLength": 80 },
              "collector_identity_trusted": { "const": false },
              "runtime_source": { "const": "windivert_userspace" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    }
  ]
}
