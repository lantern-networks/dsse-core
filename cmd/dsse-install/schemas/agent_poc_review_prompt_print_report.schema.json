{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/agent_poc_review_prompt_print_report.schema.json",
  "title": "AgentPocReviewPromptPrintReport",
  "type": "object",
  "required": [
    "status",
    "created_at",
    "source_prompt",
    "printed_prompt_bytes",
    "printed_prompt_sha256",
    "verifier_status",
    "bundle_archive",
    "bundle_archive_sha256",
    "visible_bundle_sha",
    "visible_bundle_sha_gate",
    "package_name",
    "files_checked",
    "artifact_default_leak_gate",
    "artifact_default_forbidden_marker_count",
    "default_leak_gate",
    "default_forbidden_marker_count",
    "support_bundle_default_leak_gate",
    "support_bundle_default_forbidden_marker_count",
    "support_bundle_forbidden_pattern_configured",
    "support_bundle_forbidden_pattern_gate",
    "poc_results_report_present",
    "poc_results_default_leak_gate",
    "poc_results_default_forbidden_marker_count",
    "poc_results_archive",
    "poc_results_archive_sha256",
    "poc_results_is_dry_run",
    "poc_results_evidence_step_count",
    "acceptance_status",
    "target_platform"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_prompt": {
      "type": "string",
      "const": "agent_poc_review_prompt.md"
    },
    "printed_prompt_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "printed_prompt_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "verifier_status": {
      "type": "string",
      "enum": [
        "ok"
      ]
    },
    "bundle_archive": {
      "type": "string",
      "pattern": "^agent_poc_review_bundle_[0-9]{8}T[0-9]{6}Z\\.tar\\.gz$"
    },
    "bundle_archive_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "visible_bundle_sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 shown in the human-readable Bundle section of the printed review prompt."
    },
    "visible_bundle_sha_gate": {
      "type": "string",
      "enum": [
        "ok"
      ],
      "description": "Whether the printed prompt's visible Bundle SHA-256 line matched the embedded review bundle verifier report."
    },
    "package_name": {
      "type": "string",
      "pattern": "^agent_poc_review_bundle_[0-9]{8}T[0-9]{6}Z$"
    },
    "files_checked": {
      "type": "integer",
      "minimum": 1
    },
    "artifact_default_leak_gate": {
      "type": "string",
      "enum": [
        "ok"
      ]
    },
    "artifact_default_forbidden_marker_count": {
      "type": "integer",
      "minimum": 4
    },
    "default_leak_gate": {
      "type": "string",
      "enum": [
        "ok"
      ]
    },
    "default_forbidden_marker_count": {
      "type": "integer",
      "minimum": 4
    },
    "support_bundle_default_leak_gate": {
      "type": "string",
      "enum": [
        "ok"
      ]
    },
    "support_bundle_default_forbidden_marker_count": {
      "type": "integer",
      "minimum": 4
    },
    "support_bundle_forbidden_pattern_configured": {
      "type": "boolean"
    },
    "support_bundle_forbidden_pattern_gate": {
      "type": "string",
      "enum": [
        "not_configured",
        "ok"
      ]
    },
    "poc_results_report_present": {
      "type": "boolean"
    },
    "poc_results_default_leak_gate": {
      "type": "string",
      "enum": [
        "not_configured",
        "ok"
      ]
    },
    "poc_results_default_forbidden_marker_count": {
      "type": "integer",
      "minimum": 0
    },
    "poc_results_archive": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^agent_poc_results_[0-9]{8}T[0-9]{6}Z\\.tar\\.gz$"
    },
    "poc_results_archive_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "poc_results_is_dry_run": {
      "type": "boolean"
    },
    "poc_results_evidence_step_count": {
      "type": "integer",
      "minimum": 0
    },
    "acceptance_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "accepted",
        "accepted_with_exceptions",
        "incomplete",
        "blocked",
        null
      ]
    },
    "target_platform": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "all",
        "macos",
        "windows",
        null
      ]
    }
  },
  "additionalProperties": false
}
