    },
    "degraded_operation_policy_source_category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "last_verified_signed_policy_bundle",
        "missing_verified_policy_bundle",
        "not_reported",
        null
      ]
    },
    "degraded_operation_decision_scope_category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "protected_traffic_decision_continues_metadata_only",
        "no_degraded_decision",
        "not_reported",
        null
      ]
    },
    "trust_profile_apply_failure_category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "none",
        "profile_fetch_error",
        "trust_store_permission",
        "certificate_revoked",
        "version_mismatch",
        "unknown",
        null
      ]
    },
    "agent_version_report_category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "agent_version_present",
        "agent_version_missing",
        "not_reported",
        null
      ]
    },
    "os_version_support_category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "supported_os_version",
        "unsupported_os_version",
        "unknown",
        "not_reported",
        null
      ]
    },
    "compatibility_matrix_category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "compatible",
        "incompatible",
        "unknown",
        "not_reported",
        null
      ]
    },
    "pilot_quality_measurement_scope_category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "metadata_only_no_measurement_execution",
        "measurement_result_present",
        "not_reported",
        null
      ]
    },
    "recent_error_category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "none",
        "policy_apply_failure",
        "trust_profile_failure",
        "steering_failure",
        "unknown",
        "not_reported",
        null
      ]
    },
    "agent_update_success_measurement_category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "success_rate_metadata_present",
        "success_rate_metadata_missing",
        "not_reported",
        null
      ]
    },
    "agent_rollback_success_measurement_category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "rollback_success_metadata_present",
        "rollback_success_metadata_missing",
        "not_reported",
        null
      ]
    },
    "crash_free_session_measurement_category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "crash_free_metadata_present",
        "crash_observed_metadata_present",
        "not_reported",
        null
      ]
    },
    "steering_success_measurement_category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "steering_success_metadata_present",
        "steering_failure_metadata_present",
        "not_reported",
        null
