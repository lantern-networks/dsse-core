{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/support_bundle_verifier_report.schema.json",
  "title": "SupportBundleVerifierReport",
  "type": "object",
  "required": [
    "status",
    "created_at",
    "archive",
    "archive_sha256",
    "bundle_name",
    "manifest_created_at",
    "source_dirs_redacted",
    "files_checked",
    "cache_verified",
    "default_leak_gate",
    "default_forbidden_marker_count",
    "forbidden_pattern_configured",
    "forbidden_pattern_gate",
    "doctor_status",
    "preflight_status",
    "config_directory_permissions_gate",
