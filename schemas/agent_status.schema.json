        },
        "windows_observe_process_unknown": {
          "type": "boolean"
        },
        "windows_observe_identity_authority": {
          "type": "string",
          "enum": [
            "local_client"
          ]
        },
        "windows_observe_identity_mismatch_gate": {
          "type": "string",
          "enum": [
            "ok"
          ]
        },
        "windows_observe_report_permission_gate": {
          "type": "string",
          "enum": [
            "ok"
          ]
        },
        "windows_observe_runtime_provenance_gate": {
          "type": "string",
          "enum": [
            "ok"
          ]
        },
        "windows_observe_smb445_observe_minimum_gate": {
          "type": "string",
          "enum": [
            "ok"
          ]
        },
        "windows_observe_smb445_observe_event_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "windows_observe_flow_event_schema_version": {
          "type": "string",
          "enum": [
            "windows_observe_flow_event.v1"
          ]
        },
        "windows_observe_payload_event_redaction_gate": {
          "type": "string",
          "enum": [
            "ok"
          ]
        },
        "windows_observe_next_runtime_candidate": {
          "type": "string",
          "enum": [
            "windivert_userspace",
            "wfp_callout_driver"
          ]
        }
      },
      "additionalProperties": true
    },
