          "type": "boolean"
        },
        "windows_observe_driver_running": {
          "type": "boolean"
        },
        "windows_observe_enforcement_enabled": {
          "type": "boolean"
        },
        "windows_observe_runtime_evidence_source": {
          "type": "string",
          "enum": [
            "collector_runtime"
          ]
        },
        "windows_observe_runtime_evidence_kind": {
          "type": "string",
          "enum": [
            "fixture",
            "human_windows_capture"
          ]
        },
        "windows_observe_runtime_candidate": {
          "type": "string",
          "enum": [
            "windivert_userspace_lab_candidate"
          ]
        },
        "windows_observe_product_runtime_committed": {
          "type": "boolean",
          "const": false
        },
        "windows_observe_packet_write_enabled": {
          "type": "boolean"
        },
        "windows_observe_packet_reinject_attempted": {
          "type": "integer",
          "minimum": 0
