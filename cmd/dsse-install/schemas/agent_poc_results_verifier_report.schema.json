{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/agent_poc_results_verifier_report.schema.json",
  "title": "AgentPoCResultsVerifierReport",
  "type": "object",
  "required": [
    "status",
    "created_at",
    "archive",
    "archive_sha256",
    "package_name",
    "manifest_created_at",
    "files_checked",
    "acceptance_status",
    "target_platform",
    "poc_results_is_dry_run",
    "step_counts",
    "evidence_step_count",
    "require_accepted",
    "allow_accepted_with_exceptions",
    "default_leak_gate",
    "default_forbidden_marker_count",
    "support_bundle_name",
    "support_bundle_sha256",
    "support_bundle_default_leak_gate",
    "support_bundle_default_forbidden_marker_count",
    "support_bundle_forbidden_pattern_configured",
    "support_bundle_forbidden_pattern_gate",
    "support_bundle_macos_system_proxy_steering_smoke_status",
    "support_bundle_macos_system_proxy_steering_smoke_verified"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "archive": {
      "type": "string"
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of the verified Agent PoC results tarball."
    },
    "package_name": {
      "type": "string"
    },
    "manifest_created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "files_checked": {
      "type": "integer",
      "minimum": 1
    },
    "acceptance_status": {
      "type": "string",
      "enum": [
        "accepted",
        "accepted_with_exceptions",
        "incomplete",
        "blocked"
      ]
    },
    "target_platform": {
      "type": "string",
      "enum": [
        "all",
        "macos",
        "windows"
      ]
    },
    "poc_results_is_dry_run": {
      "type": "boolean",
      "description": "True when the verified results archive was generated by the dry-run helper instead of a real endpoint PoC."
    },
    "step_counts": {
      "type": "object",
      "required": [
        "total",
        "not_started",
        "completed",
        "skipped",
        "blocked"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "not_started": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "require_accepted": {
      "type": "boolean"
    },
    "evidence_step_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of acceptance summary steps carrying updated_at, result_note, or evidence_observed."
    },
    "allow_accepted_with_exceptions": {
      "type": "boolean"
    },
    "default_leak_gate": {
      "type": "string",
      "enum": [
        "ok"
      ],
      "description": "Whether the verifier scanned the PoC results package with its built-in local path and secret marker denylist."
    },
    "default_forbidden_marker_count": {
      "type": "integer",
      "minimum": 4,
      "description": "Number of built-in denylist markers checked by the verifier."
    },
    "support_bundle_name": {
      "type": "string"
    },
    "support_bundle_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "support_bundle_default_leak_gate": {
      "type": "string",
      "enum": [
        "ok"
      ]
    },
    "support_bundle_default_forbidden_marker_count": {
      "type": "integer",
      "minimum": 4
    },
    "support_bundle_forbidden_pattern_configured": {
      "type": "boolean"
    },
    "support_bundle_forbidden_pattern_gate": {
      "type": "string",
      "enum": [
        "not_configured",
        "ok"
      ]
    },
    "support_bundle_macos_system_proxy_steering_smoke_status": {
      "type": "string",
      "enum": [
        "not_collected",
        "planned",
        "ok"
      ],
      "description": "Status of macOS System Proxy steering smoke evidence inside the nested support bundle."
    },
    "support_bundle_macos_system_proxy_steering_smoke_verified": {
      "type": "boolean",
      "description": "True when the nested support bundle carried a verified macOS System Proxy steering smoke report."
    }
  },
  "additionalProperties": false
}
