{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/trusted_keyring.schema.json",
  "title": "TrustedKeyring",
  "type": "object",
  "required": [
    "keys"
  ],
  "properties": {
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "public_key",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "public_key": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "verify_only",
              "revoked",
              "expired"
            ]
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
