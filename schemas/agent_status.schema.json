{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/agent_status.schema.json",
  "title": "AgentStatus",
  "type": "object",
  "required": [
    "device_id",
    "tenant_id",
    "policy_bundle_id",
    "policy_bundle_version",
    "bundle_source",
    "device_trust_level",
    "status",
    "timestamp"
  ],
  "properties": {
    "device_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "policy_bundle_id": {
      "type": "string"
    },
    "policy_bundle_version": {
      "type": "string"
    },
    "bundle_source": {
      "type": "string",
      "enum": [
        "remote",
        "cache_fallback"
      ]
    },
    "device_trust_level": {
      "type": "string",
      "enum": [
        "managed",
        "unmanaged",
        "unknown"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "offline"
      ]
    },
    "policy_apply_result": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "not_reported",
        "applied",
        "failed",
        "cache_fallback",
        null
      ]
    },
    "policy_apply_failure_category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "none",
        "signature_validation",
        "expired_bundle",
        "revoked_bundle",
        "version_mismatch",
        "fetch_error",
        "policy_parse_error",
        "unknown",
        null
      ]
    },
    "last_policy_apply_success_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "trust_profile_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "trust_profile_source": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "not_reported",
        "remote",
        "cache_fallback",
        null
      ]
    },
    "os_trust_store_apply_result": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "not_reported",
        "applied",
        "failed",
        "not_applicable",
        null
      ]
    },
    "browser_trust_store_apply_result": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "not_reported",
        "applied",
        "failed",
        "not_applicable",
        null
      ]
    },
    "certificate_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "certificate_revocation_state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "not_reported",
        "valid",
        "revoked",
        "unknown",
        null
      ]
    },
    "quic_policy_mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "not_reported",
        "allow",
        "detect_only",
        "prefer_tcp_tls",
        "block_quic",
        null
      ]
    },
    "decryption_bypass_policy_state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "not_reported",
        "applied",
        "failed",
        "not_applicable",
        null
      ]
    },
    "degraded_operation_control_plane_reachability_category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "control_plane_reachable",
        "control_plane_unreachable",
        "not_reported",
        null
