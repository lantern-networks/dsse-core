{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/admin_principal.schema.json",
  "title": "AdminPrincipal",
  "type": "object",
  "required": [
    "id",
    "tenant_id",
    "subject",
    "email",
    "roles",
    "idp_id",
    "status",
    "created_at",
    "last_login_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "display_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "owner",
          "admin",
          "analyst",
          "approver",
          "auditor"
        ]
      }
    },
    "idp_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled",
        "revoked"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_login_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  }
}
