# PostgreSQL client/init image. The upstream Alpine image bundles gosu 1.19,
# which is built with an obsolete Go toolchain. The official entrypoint only
# calls `gosu postgres <command>`; su-exec supports that same invocation.
FROM postgres:18.6-alpine3.24@sha256:10a5c69a83035ab5239f5620d708520e8b28f5aa1f2b20143e6024532edadfb5

RUN apk upgrade --no-cache \
    && apk add --no-cache 'su-exec=0.3-r0' \
    && rm /usr/local/bin/gosu \
    && test "$(grep -c 'exec gosu postgres' /usr/local/bin/docker-entrypoint.sh)" = 1 \
    && sed -i 's/exec gosu postgres/exec su-exec postgres/' /usr/local/bin/docker-entrypoint.sh \
    && ! grep -q 'exec gosu postgres' /usr/local/bin/docker-entrypoint.sh
