{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/network_extension_would_steer_smoke.schema.json",
  "title": "NetworkExtensionWouldSteerSmoke",
  "type": "object",
  "required": [
    "status",
    "created_at",
    "rules_manifest",
    "protected_app_map",
    "runtime_installed",
    "default_action",
    "rule_count",
    "flow_count",
    "matched_count",
    "denied_count",
    "invalid_flow_count",
    "flows"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "rules_manifest": {
      "type": "string"
    },
    "protected_app_map": {
      "type": "string"
    },
    "runtime_installed": {
      "type": "boolean",
      "description": "False for Phase 1 would-steer smoke; this does not prove a running Network Extension."
    },
    "default_action": {
      "type": "string",
      "enum": [
        "deny"
      ]
    },
    "rule_count": {
      "type": "integer",
      "minimum": 1
    },
    "flow_count": {
      "type": "integer",
      "minimum": 1
    },
    "matched_count": {
      "type": "integer",
      "minimum": 1
    },
    "denied_count": {
      "type": "integer",
      "minimum": 1
    },
    "invalid_flow_count": {
      "type": "integer",
      "minimum": 1
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "host",
          "port",
          "expected_action",
          "expected_reason",
          "action",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "expected_action": {
            "type": "string",
            "enum": [
              "tunnel",
              "deny"
            ]
          },
          "expected_reason": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "tunnel",
              "deny"
            ]
          },
          "reason": {
            "type": "string"
          },
          "application_id": {
            "type": "string"
          },
          "service_family": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
