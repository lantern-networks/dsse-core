{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/network_extension_would_steer_smoke_verifier_report.schema.json",
  "title": "NetworkExtensionWouldSteerSmokeVerifierReport",
  "type": "object",
  "required": [
    "status",
    "created_at",
    "source_report",
    "rules_manifest",
    "protected_app_map",
    "runtime_installed",
    "default_action",
    "flow_count",
    "matched_count",
    "denied_count",
    "invalid_flow_count",
    "expectations_gate",
    "secret_leak_gate"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_report": {
      "type": "string"
    },
    "rules_manifest": {
      "type": "string"
    },
    "protected_app_map": {
      "type": "string"
    },
    "runtime_installed": {
      "type": "boolean"
    },
    "default_action": {
      "type": "string",
      "enum": [
        "deny"
      ]
    },
    "flow_count": {
      "type": "integer",
      "minimum": 1
    },
    "matched_count": {
      "type": "integer",
      "minimum": 1
    },
    "denied_count": {
      "type": "integer",
      "minimum": 1
    },
    "invalid_flow_count": {
      "type": "integer",
      "minimum": 1
    },
    "expectations_gate": {
      "type": "string",
      "enum": [
        "ok"
      ]
    },
    "secret_leak_gate": {
      "type": "string",
      "enum": [
        "ok"
      ]
    }
  },
  "additionalProperties": false
}
