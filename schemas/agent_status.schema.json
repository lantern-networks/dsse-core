            "acl_unreadable",
            "hardlink",
            "identity_mismatch",
            "overclaim_capture",
            "overclaim_payload",
            "path_escape",
            "provenance_missing",
            "reparse_point",
            "report_too_large",
            "schema_mismatch",
            "stale_report",
            "toctou",
            "unavailable"
          ]
