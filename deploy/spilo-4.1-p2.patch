diff --git a/postgres-appliance/build_scripts/base.sh b/postgres-appliance/build_scripts/base.sh
index bc4633d..07adbe6 100644
--- a/postgres-appliance/build_scripts/base.sh
+++ b/postgres-appliance/build_scripts/base.sh
@@ -197 +197 @@ apt-get update
-apt-get install -y postgresql postgresql-server-dev-all postgresql-all libpq-dev
+apt-get install -y libpq-dev
@@ -328,0 +329,5 @@ find /var/log -type f -exec truncate --size 0 {} \;
+
+# DSSE: postgresql-common 295 leaves /run/postgresql to systemd-tmpfiles, which never runs in a container;
+# Patroni refuses to start without it. Created here as the published images had it.
+install -d -m 2775 -o postgres -g root /run/postgresql
+[ "$(id -u postgres):$(id -g postgres)" = "101:103" ] || { echo "postgres is $(id -u postgres):$(id -g postgres), not 101:103" >&2; exit 1; }
